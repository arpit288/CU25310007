der\); form.add\(genderPanel\);) Tj T* (        form.add\(lSem\);    form.add\(semester\);) Tj T* (        form.add\(submit\);  form.add\(reset\);) Tj T*  T* (        output = new TextArea\(6, 30\);) Tj T* (        output.setEditable\(false\);) Tj T*  T* (        add\(new Label\("   "\), BorderLayout.WEST\);) Tj T* (        add\(form, BorderLayout.CENTER\);) Tj T* (        add\(output, BorderLayout.SOUTH\);) Tj T*  T* (        submit.addActionListener\(this\);) Tj T* (        reset.addActionListener\(this\);) Tj T*  T* (        addWindowListener\(new WindowAdapter\(\) {) Tj T* (            public void windowClosing\(WindowEvent e\) {) Tj T* (                dispose\(\);) Tj T* (            }) Tj T* (        }\);) Tj T* ET
