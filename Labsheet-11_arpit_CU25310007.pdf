BT 1 0 0 1 3 650.5 Tm /F3 7.5 Tf 9.4 TL (    Main\(\) {) Tj T* (        setTitle\("Student Marksheet"\);) Tj T* (        setLayout\(new BorderLayout\(10, 10\)\);) Tj T*  T* (        JPanel panel = new JPanel\(new GridLayout\(6, 2, 10, 10\)\);) Tj T* (        panel.setBorder\(new EmptyBorder\(15, 20, 5, 20\)\);) Tj T*  T* (        for \(int i = 0; i < 5; i++\) {) Tj T* (            panel.add\(new JLabel\(subjects[i] + " \(out of 100\):"\)\);) Tj T* (            marks[i] = new JTextField\(\);) Tj T* (            panel.add\(marks[i]\);) Tj T* (        }) Tj T* (        calculate = new JButton\("Calculate Result"\);) Tj T* (        panel.add\(new JLabel\(""\)\);) Tj T* (        panel.add\(calculate\);) Tj T* (        calculate.addActionListener\(this\);) Tj T*  T* (        result = new JTextArea\(6, 25\);) Tj T* (        result.setEditable\(false\);) Tj T* (        result.setBorder\(new EmptyBorder\(8, 20, 8, 20\)\);) Tj T*  T* (        add\(panel, BorderLayout.CENTER\);) Tj T* (        add\(result, BorderLayout.SOUTH\);) Tj T*  T* (        setDefaultCloseOperation\(EXIT_ON_CLOSE\);) Tj T* (        setSize\(420, 450\);) Tj T* (        setLocationRelativeTo\(null\);) Tj T* (        setVisible\(true\);) Tj T* (    }) Tj T*  T* (    public void actionPerformed\(ActionEvent e\) {) Tj T* (        int total = 0;) Tj T* (        boolean pass = true;) Tj T* (        try {) Tj T* (            for \(int i = 0; i < 5; i++\) {) Tj T* (                int m = Integer.parseInt\(marks[i].getText\(\).trim\(\)\);) Tj T* (                if \(m < 0 || m > 100\) {) Tj T* (                    JOptionPane.showMessageDialog\(this, "Marks must be between 0 and 100."\);) Tj T* (                    return;) Tj T* (                }) Tj T* (                total += m;) Tj T* (                if \(m < 40\) {) Tj T* (                    pass = false;) Tj T* (                }) Tj T* (            }) Tj T* (        } catch \(NumberFormatException ex\) {) Tj T* (            JOptionPane.showMessageDialog\(this, "Please enter valid marks in all fields."\);) Tj T* (            return;) Tj T* (        }) Tj T*  T* (        double percentage = total / 5.0;) Tj T* (        String grade;) Tj T* (        if \(!pass\) grade = "F";) Tj T* (        else if \(percentage >= 90\) grade = "A+";) Tj T* (        else if \(percentage >= 80\) grade = "A";) Tj T* (        else if \(percentage >= 70\) grade = "B+";) Tj T* (        else if \(percentage >= 60\) grade = "B";) Tj T* (        else if \(percentage >= 50\) grade = "C";) Tj T* (        else grade = "D";) Tj T*  T* (        result.setText\("Total Marks : " + total + " / 500\\n") Tj T* (                + "Percentage  : " + String.format\("%.2f", percentage\) + " %\\n") Tj T* (                + "Grade       : " + grade + "\\n") Tj T* (                + "Status      : " + \(pass ? "PASS" : "FAIL"\)\);) Tj T* (    }) Tj T*  T* (    public static void main\(String[] args\) {) Tj T* (        new Main\(\);) Tj T* (    }) Tj T* (}) Tj T* ET
