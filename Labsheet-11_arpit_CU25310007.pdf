BT 1 0 0 1 3 678.7 Tm /F3 7.5 Tf 9.4 TL (        withdraw = new JButton\("Withdraw"\);) Tj T* (        check = new JButton\("Check Balance"\);) Tj T* (        clear = new JButton\("Clear"\);) Tj T* (        JPanel buttons = new JPanel\(new GridLayout\(1, 4, 8, 8\)\);) Tj T* (        buttons.setBorder\(new EmptyBorder\(5, 20, 20, 20\)\);) Tj T* (        buttons.add\(deposit\);) Tj T* (        buttons.add\(withdraw\);) Tj T* (        buttons.add\(check\);) Tj T* (        buttons.add\(clear\);) Tj T*  T* (        deposit.addActionListener\(this\);) Tj T* (        withdraw.addActionListener\(this\);) Tj T* (        check.addActionListener\(this\);) Tj T* (        clear.addActionListener\(this\);) Tj T*  T* (        add\(form, BorderLayout.CENTER\);) Tj T* (        add\(buttons, BorderLayout.SOUTH\);) Tj T*  T* (        setDefaultCloseOperation\(EXIT_ON_CLOSE\);) Tj T* (        setSize\(520, 250\);) Tj T* (        setLocationRelativeTo\(null\);) Tj T* (        setVisible\(true\);) Tj T* (    }) Tj T*  T* (    double readAmount\(\) {) Tj T* (        try {) Tj T* (            double amt = Double.parseDouble\(tAmount.getText\(\).trim\(\)\);) Tj T* (            if \(amt <= 0\) {) Tj T* (                JOptionPane.showMessageDialog\(this, "Amount must be greater than zero.",) Tj T* (                        "Invalid Amount", JOptionPane.WARNING_MESSAGE\);) Tj T* (                return -1;) Tj T* (            }) Tj T* (            return amt;) Tj T* (        } catch \(NumberFormatException ex\) {) Tj T* (            JOptionPane.showMessageDialog\(this, "Please enter a valid amount.",) Tj T* (                    "Invalid Input", JOptionPane.ERROR_MESSAGE\);) Tj T* (            return -1;) Tj T* (        }) Tj T* (    }) Tj T*  T* (    public void actionPerformed\(ActionEvent e\) {) Tj T* (        if \(e.getSource\(\) == deposit\) {) Tj T* (            double amt = readAmount\(\);) Tj T* (            if \(amt > 0\) {) Tj T* (                balance += amt;) Tj T* (                tBalance.setText\(String.format\("%.2f", balance\)\);) Tj T* (                JOptionPane.showMessageDialog\(this, "Rs. " + amt + " deposited successfully."\);) Tj T* (            }) Tj T* (        } else if \(e.getSource\(\) == withdraw\) {) Tj T* (            double amt = readAmount\(\);) Tj T* (            if \(amt > 0\) {) Tj T* (                if \(amt <= balance\) {) Tj T* (                    balance -= amt;) Tj T* (                    tBalance.setText\(String.format\("%.2f", balance\)\);) Tj T* (                    JOptionPane.showMessageDialog\(this, "Rs. " + amt + " withdrawn successfully."\);) Tj T* (                } else {) Tj T* (                    JOptionPane.showMessageDialog\(this, "Insufficient balance!",) Tj T* (                            "Error", JOptionPane.ERROR_MESSAGE\);) Tj T* (                }) Tj T* (            }) Tj T* (        } else if \(e.getSource\(\) == check\) {) Tj T* (            JOptionPane.showMessageDialog\(this, "Current Balance: Rs. " + String.format\("%.2f", balance\)\);) Tj T* (        } else if \(e.getSource\(\) == clear\) {) Tj T* (            tAccNo.setText\(""\);) Tj T* (            tName.setText\(""\);) Tj T* (            tAmount.setText\(""\);) Tj T* (        }) Tj T* (    }) Tj T*  T* (    public static void main\(String[] args\) {) Tj T* (        new Main\(\);) Tj T* (    }) Tj T* (}) Tj T* ET
